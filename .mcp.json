{
  "mcpServers": {
    "knowledge-graph": {
      "command": "graphify-mcp",
      "args": [
        "--graph",
        "build/knowledge-graph/graphify-out/graph.json"
      ]
    },
    "intrinsic-sandbox": {
      "command": "bash",
      "args": [
        "-c",
        "repo_root=$(git rev-parse --show-toplevel) || exit; exec python3 \"$repo_root/tools/agents/mcp_bridge.py\""
      ]
    }
  }
}
