#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_fp64 : require
#include "include/point_lbvh.glsl"

layout(local_size_x=64) in;
layout(push_constant,scalar) uniform Push {
    uint64_t nodes, points, slots, scratch, result;
    uint count, first, queryCount, minimumNeighbors;
    float salientRadius, nonmaxRadius;
    double gamma21, gamma32;
    uint capacity, mode;
} pc;
layout(buffer_reference,scalar) buffer Doubles { double v[]; };
layout(buffer_reference,scalar) buffer Output {
    uint error, maximumNeighbors, keypointCount, reserved;
    float meanSpacing, salientRadius, nonmaxRadius, reservedFloat;
    uvec2 values[];
};
shared double sums[64];

bool failed() { return atomicAdd(Output(pc.result).error,0)!=0; }
void fail(uint error) { atomicOr(Output(pc.result).error,error); }

// Match the reference's isotropic branch; only eigenvalues are needed here.
// Jacobi avoids an unavailable GLSL double-precision acos/cos implementation.
vec3 eigenvalues(dmat3 a)
{
    precise double mean=(a[0][0]+a[1][1]+a[2][2])/3.0lf;
    precise dvec3 b=dvec3(a[0][0],a[1][1],a[2][2])-mean;
    precise double p2=(b.x*b.x+b.y*b.y+b.z*b.z+
        2.0lf*(a[0][1]*a[0][1]+a[0][2]*a[0][2]+a[1][2]*a[1][2]))/6.0lf;
    double scale=1.0lf;
    for(uint c=0;c<3;++c)for(uint r=0;r<3;++r)scale=max(scale,abs(a[c][r]));
    if(!(p2>2.2204460492503131e-16lf*scale*scale))return vec3(max(mean,0.0lf));
    for(uint step=0;step<24;++step)
    {
        uint p=0,q=1;
        if(abs(a[0][2])>abs(a[p][q])){p=0;q=2;}
        if(abs(a[1][2])>abs(a[p][q])){p=1;q=2;}
        if(abs(a[p][q])<=1e-30lf*scale)break;
        precise double tau=(a[q][q]-a[p][p])/(2.0lf*a[p][q]);
        precise double t=(tau>=0.0lf?1.0lf:-1.0lf)/(abs(tau)+sqrt(1.0lf+tau*tau));
        precise double c=1.0lf/sqrt(1.0lf+t*t),s=t*c;
        precise double shift=t*a[p][q];
        a[p][p]-=shift;a[q][q]+=shift;a[p][q]=0.0lf;a[q][p]=0.0lf;
        for(uint k=0;k<3;++k)if(k!=p && k!=q)
        {
            precise double x=a[k][p],y=a[k][q];
            a[k][p]=c*x-s*y;a[p][k]=a[k][p];
            a[k][q]=s*x+c*y;a[q][k]=a[k][q];
        }
    }
    dvec3 e=max(dvec3(a[0][0],a[1][1],a[2][2]),dvec3(0.0lf));
    if(e.x<e.y){double t=e.x;e.x=e.y;e.y=t;}
    if(e.y<e.z){double t=e.y;e.y=e.z;e.z=t;}
    if(e.x<e.y){double t=e.x;e.x=e.y;e.y=t;}
    return vec3(e);
}

void score(uint i)
{
    Output result=Output(pc.result);
    Doubles scores=Doubles(pc.scratch);
    scores.v[i]=double(uintBitsToFloat(0x7fc00000u));
    result.values[i]=uvec2(0);
    if(failed())return;
    vec3 center=lbvhPoint(pc.points,12,i);
    uint original=LbvhIndices(pc.slots).v[i];
    float salientSquared=result.salientRadius*result.salientRadius;
    float support=max(result.salientRadius,result.nonmaxRadius);
    float supportSquared=support*support;
    precise dvec3 mean=dvec3(center);
    dmat3 covariance=dmat3(0.0lf);
    uint salientCount=0;
    for(uint pass=0;pass<2;++pass)
    {
        if(pass==1)
        {
            precise dvec3 delta=dvec3(center)-mean;
            covariance=outerProduct(delta,delta);
        }
        float querySquared=pass==0?supportSquared:salientSquared;
        uint stack[64];uint size=1;stack[0]=0;uint supportCount=0;
        while(size>0)
        {
            LbvhNode node=LbvhNodes(pc.nodes).v[stack[--size]];
            if(lbvhDistance(center,clamp(center,node.lo,node.hi))>querySquared)continue;
            if(node.object==LBVH_INVALID)
            {
                if(size>62){fail(8);return;}
                stack[size++]=node.right;stack[size++]=node.left;continue;
            }
            if(node.object==original)continue;
            float distance=lbvhDistance(center,node.lo);
            if(distance>querySquared)continue;
            if(pass==0 && ++supportCount>pc.capacity)
            {atomicMax(result.maximumNeighbors,supportCount);fail(2);return;}
            if(distance>salientSquared)continue;
            if(pass==0){mean+=dvec3(node.lo);++salientCount;}
            else
            {
                precise dvec3 delta=dvec3(node.lo)-mean;
                covariance+=outerProduct(delta,delta);
            }
        }
        if(pass==0)
        {
            atomicMax(result.maximumNeighbors,supportCount);
            if(salientCount<pc.minimumNeighbors)return;
            mean/=double(salientCount+1);
        }
    }
    covariance/=double(salientCount+1);
    vec3 e=eigenvalues(covariance);
    if(any(isnan(e)) || any(isinf(e))){fail(4);return;}
    // Same numerical-zero contract as the CPU keypoint reducer.
    double roundoff=64.0lf*2.2204460492503131e-16lf*double(e.x);
    if(double(e.y)<=roundoff)e.y=0;
    if(double(e.z)<=roundoff)e.z=0;
    if(e.x>0 && e.y>0 && double(e.y)/double(e.x)<=pc.gamma21 && double(e.z)/double(e.y)<=pc.gamma32)
    {
        scores.v[i]=double(e.z);
        result.values[i].x=floatBitsToUint(e.z);
    }
}

void suppress(uint i)
{
    if(failed())return;
    double value=Doubles(pc.scratch).v[i];
    if(isnan(value))return;
    vec3 center=lbvhPoint(pc.points,12,i);
    uint original=LbvhIndices(pc.slots).v[i];
    float radius=Output(pc.result).nonmaxRadius;
    float radiusSquared=radius*radius;
    uint stack[64];uint size=1;stack[0]=0;
    while(size>0)
    {
        LbvhNode node=LbvhNodes(pc.nodes).v[stack[--size]];
        if(lbvhDistance(center,clamp(center,node.lo,node.hi))>radiusSquared)continue;
        if(node.object==LBVH_INVALID)
        {
            if(size>62){fail(8);return;}
            stack[size++]=node.right;stack[size++]=node.left;continue;
        }
        if(node.object==original || lbvhDistance(center,node.lo)>radiusSquared)continue;
        double other=Doubles(pc.scratch).v[node.reserved];
        if(!isnan(other) && (other>value || (other==value && node.object<original)))return;
    }
    Output(pc.result).values[i].y=1;
    atomicAdd(Output(pc.result).keypointCount,1);
}

void main()
{
    if(pc.mode==1)
    {
        uint lane=gl_LocalInvocationIndex;
        precise double sum=0.0lf;
        for(uint i=lane;i<pc.count;i+=64)sum+=Doubles(pc.scratch).v[i];
        sums[lane]=sum;barrier();
        for(uint stride=32;stride>0;stride/=2)
        {if(lane<stride)sums[lane]+=sums[lane+stride];barrier();}
        if(lane==0)
        {
            Output result=Output(pc.result);
            float spacing=float(sums[0]/double(pc.count));
            float salient=pc.salientRadius>0?pc.salientRadius:6.0*spacing;
            float nonmax=pc.nonmaxRadius>0?pc.nonmaxRadius:4.0*spacing;
            if(isnan(spacing) || isinf(spacing) || spacing<=0 ||
                salient<=0 || nonmax<=0 || max(salient,nonmax)>1e18 ||
                salient*salient==0 || nonmax*nonmax==0){fail(1);return;}
            result.meanSpacing=spacing;result.salientRadius=salient;result.nonmaxRadius=nonmax;
        }
        return;
    }
    uint local=gl_GlobalInvocationID.x;
    if(local>=pc.queryCount)return;
    uint i=pc.first+local;
    if(pc.mode==0)
    {
        uint original=LbvhIndices(pc.slots).v[i];
        LbvhNeighbor neighbor=lbvhNearest(pc.nodes,pc.count,lbvhPoint(pc.points,12,i),original);
        precise float spacing=sqrt(neighbor.distance);
        Doubles(pc.scratch).v[i]=double(spacing);
        if(neighbor.index==LBVH_INVALID || isnan(spacing) || isinf(spacing))fail(1);
    }
    else if(pc.mode==2)score(i);
    else suppress(i);
}
