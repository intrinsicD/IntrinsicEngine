#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_fp64 : require
#include "include/point_lbvh.glsl"

layout(local_size_x=64) in;
layout(push_constant,scalar) uniform Push {
    uint64_t nodes, points, slots, scratch, result;
    uint count, first, queryCount, minimumNeighbors;
    float salientRadius, nonmaxRadius;
    double gamma21, gamma32;
    uint reserved, mode;
    uint64_t states, scores, masks;
    uint visits, resume;
} pc;
layout(buffer_reference,scalar) buffer Doubles { double v[]; };
layout(buffer_reference,scalar) buffer Output {
    uint error, maximumNeighbors, keypointCount, reserved;
    float meanSpacing, salientRadius, nonmaxRadius, reservedFloat;
    uvec2 values[];
};
shared double sums[64];

bool failed() { return atomicAdd(Output(pc.result).error,0)!=0; }
void fail(uint error) { atomicOr(Output(pc.result).error,error); }

// Decode public float bits in double, including denormals on FTZ devices.
double realFloat(uint bits) {
    if((bits & 0x7f800000u)==0) return double(bits & 0x007fffffu)*1.4012984643248171e-45lf*((bits & 0x80000000u)==0?1.0lf:-1.0lf);
    return double(uintBitsToFloat(bits));
}
uint floatBits(double value) {
    return abs(value)<1.1754943508222875e-38lf
        ? uint(roundEven(abs(value)/1.4012984643248171e-45lf)) | (value<0.0lf?0x80000000u:0u)
        : floatBitsToUint(float(value));
}
double roundedFloat(double value) { return realFloat(floatBits(value)); }
dvec3 point(uint row) {
    LbvhIndices bits=LbvhIndices(pc.points+uint64_t(row)*12);
    return dvec3(realFloat(bits.v[0]),realFloat(bits.v[1]),realFloat(bits.v[2]));
}
double distanceSquared(dvec3 a,dvec3 b) {
    // Match the CPU/KD-tree float subtraction, products and left-associated sum.
    // Explicit rounding also preserves subnormal intermediates on FTZ devices.
    precise dvec3 d=a-b;
    d=dvec3(roundedFloat(d.x),roundedFloat(d.y),roundedFloat(d.z));
    precise dvec3 squared=d*d;
    squared=dvec3(roundedFloat(squared.x),roundedFloat(squared.y),roundedFloat(squared.z));
    return roundedFloat(roundedFloat(squared.x+squared.y)+squared.z);
}
// Match the reference's isotropic branch; only eigenvalues are needed here.
// Jacobi avoids an unavailable GLSL double-precision acos/cos implementation.
dvec3 eigenvalues(dmat3 a)
{
    precise double mean=(a[0][0]+a[1][1]+a[2][2])/3.0lf;
    precise dvec3 b=dvec3(a[0][0],a[1][1],a[2][2])-mean;
    precise double p2=(b.x*b.x+b.y*b.y+b.z*b.z+
        2.0lf*(a[0][1]*a[0][1]+a[0][2]*a[0][2]+a[1][2]*a[1][2]))/6.0lf;
    double scale=1.0lf;
    for(uint c=0;c<3;++c)for(uint r=0;r<3;++r)scale=max(scale,abs(a[c][r]));
    if(!(p2>2.2204460492503131e-16lf*scale*scale))return dvec3(max(mean,0.0lf));
    for(uint step=0;step<24;++step)
    {
        uint p=0,q=1;
        if(abs(a[0][2])>abs(a[p][q])){p=0;q=2;}
        if(abs(a[1][2])>abs(a[p][q])){p=1;q=2;}
        if(abs(a[p][q])<=1e-30lf*scale)break;
        precise double tau=(a[q][q]-a[p][p])/(2.0lf*a[p][q]);
        precise double t=(tau>=0.0lf?1.0lf:-1.0lf)/(abs(tau)+sqrt(1.0lf+tau*tau));
        precise double c=1.0lf/sqrt(1.0lf+t*t),s=t*c;
        precise double shift=t*a[p][q];
        a[p][p]-=shift;a[q][q]+=shift;a[p][q]=0.0lf;a[q][p]=0.0lf;
        for(uint k=0;k<3;++k)if(k!=p && k!=q)
        {
            precise double x=a[k][p],y=a[k][q];
            a[k][p]=c*x-s*y;a[p][k]=a[k][p];
            a[k][q]=s*x+c*y;a[q][k]=a[k][q];
        }
    }
    dvec3 e=max(dvec3(a[0][0],a[1][1],a[2][2]),dvec3(0.0lf));
    if(e.x<e.y){double t=e.x;e.x=e.y;e.y=t;}
    if(e.y<e.z){double t=e.y;e.y=e.z;e.z=t;}
    if(e.x<e.y){double t=e.x;e.x=e.y;e.y=t;}
    return e;
}


// Scalar layout stride = 384 bytes. Traversal and covariance persist across
// completions; a dense row never monopolizes a shader invocation.
struct RowState {
    uint stack[64]; dvec3 mean; dmat3 covariance; double best;
    uint size, pass, salient, support, done;
};
layout(buffer_reference,scalar) buffer States { RowState v[]; };

void finishScore(uint i, inout RowState r)
{
    dvec3 e=eigenvalues(r.covariance/double(r.salient+1));
    e=dvec3(realFloat(floatBits(e.x)),realFloat(floatBits(e.y)),realFloat(floatBits(e.z)));
    if(any(isnan(e)) || any(isinf(e))){fail(4);return;}
    double roundoff=64.0lf*2.2204460492503131e-16lf*double(e.x);
    if(double(e.y)<=roundoff)e.y=0;
    if(double(e.z)<=roundoff)e.z=0;
    if(e.x>0 && e.y>0 && double(e.y)/double(e.x)<=pc.gamma21 && double(e.z)/double(e.y)<=pc.gamma32)
    {
        Doubles(pc.scratch).v[i]=double(e.z);
        Output(pc.result).values[i].x=floatBits(e.z);
    }
}
void traverse(uint i)
{
    Output result=Output(pc.result);
    uint original=LbvhIndices(pc.slots).v[i];
    dvec3 center=point(original);
    RowState r=States(pc.states).v[i-pc.first];
    if(pc.resume==0) {
        r.size=1;r.stack[0]=0;r.pass=0;r.salient=0;r.support=0;r.done=0;
        r.mean=dvec3(center);r.covariance=dmat3(0.0lf);r.best=3.402823466e38lf;
        if(pc.mode==2) {
            Doubles(pc.scratch).v[i]=double(uintBitsToFloat(0x7fc00000u));
            result.values[i]=uvec2(0);
        }
        if(pc.mode==3 && isnan(Doubles(pc.scratch).v[i]))r.done=1;
    }
    if(r.done!=0 || failed())return;
    double salient=realFloat(floatBitsToUint(result.salientRadius)),nonmax=realFloat(floatBitsToUint(result.nonmaxRadius));
    double salientSquared=roundedFloat(salient*salient);
    for(uint visit=0;visit<pc.visits && r.done==0;++visit) {
        if(r.size==0) {
            if(pc.mode==0) {
                Doubles(pc.scratch).v[i]=roundedFloat(sqrt(r.best));
                r.done=1;
            } else if(pc.mode==2 && r.pass==0) {
                atomicMax(result.maximumNeighbors,r.support);
                if(r.salient<pc.minimumNeighbors){r.done=1;break;}
                r.mean/=double(r.salient+1);
                precise dvec3 delta=dvec3(center)-r.mean;
                r.covariance=outerProduct(delta,delta);
                r.pass=1;r.size=1;r.stack[0]=0;
            } else {
                if(pc.mode==2)finishScore(i,r);
                else {result.values[i].y=1;atomicAdd(result.keypointCount,1);}
                r.done=1;
            }
            continue;
        }
        double limit=pc.mode==0?r.best:pc.mode==3?roundedFloat(nonmax*nonmax):
            salientSquared;
        LbvhNode node=LbvhNodes(pc.nodes).v[r.stack[--r.size]];
        // Float LBVH construction may flush tiny bounds. Widen that band;
        // leaf membership always uses the canonical float bits decoded in double.
        dvec3 lo=dvec3(node.lo),hi=dvec3(node.hi);
        for(uint axis=0;axis<3;++axis) {
            if(abs(lo[axis])<1.1754943508222875e-38lf)lo[axis]=-1.1754943508222875e-38lf;
            if(abs(hi[axis])<1.1754943508222875e-38lf)hi[axis]=1.1754943508222875e-38lf;
        }
        if(distanceSquared(center,clamp(center,lo,hi))>limit)continue;
        if(node.object==LBVH_INVALID) {
            if(r.size>62){fail(8);return;}
            r.stack[r.size++]=node.right;r.stack[r.size++]=node.left;continue;
        }
        if(node.object==original)continue;
        dvec3 neighbor=point(node.object);
        double distance=distanceSquared(center,neighbor);
        if(distance>limit)continue;
        if(pc.mode==0) {
            r.best=double(distance);
            // No tie identity is required for spacing; zero is the absolute minimum.
            if(distance==0)r.size=0;
        } else if(pc.mode==2) {
            if(r.pass==0)++r.support;
            if(distance>salientSquared)continue;
            if(r.pass==0){r.mean+=neighbor;++r.salient;}
            else {precise dvec3 delta=neighbor-r.mean;r.covariance+=outerProduct(delta,delta);}
        } else {
            double value=Doubles(pc.scratch).v[i],other=Doubles(pc.scratch).v[node.reserved];
            if(!isnan(other) && (other>value || (other==value && node.object<original)))r.done=1;
        }
    }
    States(pc.states).v[i-pc.first]=r;
    if(r.done==0)atomicAdd(result.reserved,1);
}
void main()
{
    if(pc.mode==1 || pc.mode==5) {
        uint lane=gl_LocalInvocationIndex;
        uint begin=pc.mode==5?pc.first+gl_WorkGroupID.x*4096:pc.count;
        uint end=pc.mode==5?min(begin+4096,pc.first+pc.queryCount):pc.count+(pc.count+4095)/4096;
        precise double sum=0.0lf;
        for(uint i=begin+lane;i<end;i+=64)sum+=Doubles(pc.scratch).v[i];
        sums[lane]=sum;barrier();
        for(uint stride=32;stride>0;stride/=2)
        {if(lane<stride)sums[lane]+=sums[lane+stride];barrier();}
        if(lane==0) {
            if(pc.mode==5) {Doubles(pc.scratch).v[pc.count+pc.first/4096+gl_WorkGroupID.x]=sums[0];return;}
            Output result=Output(pc.result);
            double spacing=realFloat(floatBits(sums[0]/double(pc.count)));
            double requestedSalient=realFloat(floatBitsToUint(pc.salientRadius)),requestedNonmax=realFloat(floatBitsToUint(pc.nonmaxRadius));
            double salient=requestedSalient>0?requestedSalient:realFloat(floatBits(6.0lf*spacing));
            double nonmax=requestedNonmax>0?requestedNonmax:realFloat(floatBits(4.0lf*spacing));
            if(isnan(spacing)||isinf(spacing)||spacing<=0||salient<=0||nonmax<=0||
                max(salient,nonmax)>1e18||roundedFloat(salient*salient)==0||roundedFloat(nonmax*nonmax)==0){fail(1);return;}
            LbvhIndices(pc.result).v[4]=floatBits(spacing);LbvhIndices(pc.result).v[5]=floatBits(salient);LbvhIndices(pc.result).v[6]=floatBits(nonmax);
        }
        return;
    }
    uint local=gl_GlobalInvocationID.x;
    if(local>=pc.queryCount)return;
    uint i=pc.first+local;
    if(pc.mode==4) {
        uint slot=LbvhIndices(pc.slots).v[i];
        LbvhIndices(pc.scores).v[slot]=Output(pc.result).values[i].x;
        LbvhIndices(pc.masks).v[slot]=Output(pc.result).values[i].y;
    } else traverse(i);
}
