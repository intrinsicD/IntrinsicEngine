#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_fp64 : require
#include "include/point_lbvh.glsl"
#include "include/point_lbvh_double.glsl"
#include "include/pca_eigen_double.glsl"
layout(local_size_x=64) in;
layout(buffer_reference,scalar) buffer NormalStats {
    uint overflow, valid, fallback, tooFew, collinear, degenerate, duplicates, fallbackRepaired;
};
layout(push_constant,scalar) uniform Push {
    uint64_t positions, nodes, slots, neighbors, outputValues, stats;
    double epsilon, collinearRatio;
    uint count, width, minimumNeighbors, radiusSearch;
    float radius, fallbackX, fallbackY, fallbackZ;
    uint first, threads;
} pc;
// Preserve binary32 subnormals even on devices whose float ALU/conversions flush.
// Values stay double between explicitly rounded public-reference float operations.
double roundedFloat(double x)
{
    if(abs(x)<1.1754943508222875e-38lf)
        return roundEven(x/1.4012984643248171e-45lf)*1.4012984643248171e-45lf;
    return double(float(x));
}
dvec3 roundedVector(dvec3 n)
{
    return dvec3(roundedFloat(n.x),roundedFloat(n.y),roundedFloat(n.z));
}
double squaredFloatLength(dvec3 n)
{
    precise double xy=roundedFloat(roundedFloat(n.x*n.x)+roundedFloat(n.y*n.y));
    return roundedFloat(xy+roundedFloat(n.z*n.z));
}
bool normalizeNormal(inout dvec3 n)
{
    precise double squared=squaredFloatLength(n);
    if(isnan(squared)||isinf(squared)||squared<=pc.epsilon*pc.epsilon)return false;
    precise double inverse=roundedFloat(1.0lf/sqrt(squared));
    n=roundedVector(n*inverse);
    return !any(isnan(n))&&!any(isinf(n));
}
void main()
{
    uint local=gl_GlobalInvocationID.x;
    if(local>=pc.threads)return;
    uint row=LbvhIndices(pc.slots).v[pc.first+local],base=local*pc.width;
    vec3 center=lbvhPoint(pc.positions,12,row);
    LbvhNeighbors neighbors=LbvhNeighbors(pc.neighbors);
    NormalStats stats=NormalStats(pc.stats);
    // k+1 INCLUDING self, then identity filtering (including coincident tie cases).
    uint count=lbvhQueryDouble(pc.positions,pc.nodes,pc.count,center,LBVH_INVALID,
        double(pc.radius),pc.radiusSearch==0?pc.width:0,pc.width,neighbors,base,true);
    if(count>pc.width){atomicOr(stats.overflow,1);return;}
    uint used=0;
    for(uint j=0;j<count;++j)
    {
        uint id=neighbors.v[base+j].index;
        if(id!=row)neighbors.v[base+used++].index=id;
    }
    // Radius traversal returns source order; PCA accumulates distance/index order.
    if(pc.radiusSearch!=0)
        lbvhSortRadiusDouble(neighbors,base,used,pc.positions,center,true);
    dvec3 normal=dvec3(pc.fallbackX,pc.fallbackY,pc.fallbackZ);
    if(!normalizeNormal(normal)){normal=dvec3(0,0,1);atomicOr(stats.fallbackRepaired,1);}
    bool valid=false;
    if(used<pc.minimumNeighbors)atomicAdd(stats.tooFew,1);
    else if(used+1<3)atomicAdd(stats.degenerate,1);
    else
    {
        // Match the reference's duplicate diagnostic, including its float distance rounding.
        for(uint i=0;i<used;++i)
        {
            dvec3 point=dvec3(lbvhPoint(pc.positions,12,neighbors.v[base+i].index));
            for(uint j=0;j<=i;++j)
            {
                dvec3 previous=dvec3(j==0?center:lbvhPoint(pc.positions,12,neighbors.v[base+j-1].index));
                double squared=squaredFloatLength(roundedVector(point-previous));
                if(isinf(squared)||isnan(squared)||squared<=pc.epsilon*pc.epsilon)
                {atomicAdd(stats.duplicates,1);break;}
            }
        }
        precise dvec3 mean=dvec3(center);
        for(uint j=0;j<used;++j)mean+=dvec3(lbvhPoint(pc.positions,12,neighbors.v[base+j].index));
        mean/=double(used+1);
        precise double c00=0.0lf,c01=0.0lf,c02=0.0lf,c11=0.0lf,c12=0.0lf,c22=0.0lf;
        for(uint j=0;j<=used;++j)
        {
            precise dvec3 d=dvec3(j==0?center:lbvhPoint(pc.positions,12,neighbors.v[base+j-1].index))-mean;
            c00+=d.x*d.x;c01+=d.x*d.y;c02+=d.x*d.z;
            c11+=d.y*d.y;c12+=d.y*d.z;c22+=d.z*d.z;
        }
        precise double inverse=1.0lf/double(used+1);
        dvec3 eigenvalues;dmat3 eigenvectors;
        pcaEigen(c00*inverse,c01*inverse,c02*inverse,c11*inverse,c12*inverse,c22*inverse,eigenvalues,eigenvectors);
        dvec3 values=roundedVector(eigenvalues);
        double largest=max(values.x,0.0lf);
        if(largest<=roundedFloat(pc.epsilon) || values.y<=roundedFloat(largest*roundedFloat(pc.collinearRatio)))atomicAdd(stats.collinear,1);
        else
        {
            dvec3 candidate=roundedVector(eigenvectors[2]);
            if(normalizeNormal(candidate))
            {
                // Geometry.PointCloud.Normals: largest magnitude positive, x/y/z tie order.
                uint axis=0;
                if(abs(candidate.y)>abs(candidate[axis]))axis=1;
                if(abs(candidate.z)>abs(candidate[axis]))axis=2;
                if(candidate[axis]<0.0lf)candidate=-candidate;
                normal=candidate;valid=true;
            }
            else atomicAdd(stats.degenerate,1);
        }
    }
    if(valid)atomicAdd(stats.valid,1);else atomicAdd(stats.fallback,1);
    for(uint k=0;k<3;++k)
    {
        lbvhStorePositiveFloat(pc.outputValues,row*3+k,abs(normal[k]));
        if(normal[k]<0.0lf)LbvhIndices(pc.outputValues).v[row*3+k]|=0x80000000u;
    }
}
