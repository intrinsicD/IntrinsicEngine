#version 460
// Transform immutable ICP query points using the CPU solver's double-precision pose.
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 256) in;
layout(buffer_reference, scalar) readonly buffer Points { float v[]; };
layout(buffer_reference, scalar) readonly buffer Pose { dmat4 value; };
layout(buffer_reference, scalar) writeonly buffer Output { float v[]; };
layout(push_constant, scalar) uniform Push {
    uint64_t source, pose, destination;
    uint count, stride;
} pc;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    Points points = Points(pc.source);
    uint at = i * (pc.stride / 4u);
    dmat4 matrix = Pose(pc.pose).value;
    dvec3 point = dvec3(points.v[at], points.v[at + 1u], points.v[at + 2u]);
    // Match glm's paired addition order as well as its double precision.
    precise dvec4 transformed = (matrix[0]*point.x + matrix[1]*point.y) +
                               (matrix[2]*point.z + matrix[3]);
    Output outPoints = Output(pc.destination);
    outPoints.v[3u * i] = float(transformed.x);
    outPoints.v[3u * i + 1u] = float(transformed.y);
    outPoints.v[3u * i + 2u] = float(transformed.z);
}
