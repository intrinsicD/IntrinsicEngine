#version 460
// Batched nearest-centroid assignment through the shared device LBVH.
#extension GL_GOOGLE_include_directive : require
#include "include/point_lbvh.glsl"
layout(local_size_x=256) in;
#include "include/kmeans_state.glsl"
layout(buffer_reference, scalar) readonly buffer FloatArrayRO { float Values[]; };
layout(buffer_reference, scalar) buffer FloatArray { float Values[]; };
layout(buffer_reference, scalar) buffer UIntArray { uint Values[]; };


void main()
{
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.PointCount || pc.StateBDA==uint64_t(0) || pc.NodesBDA==uint64_t(0))return;
    KMeansStateRef state=KMeansStateRef(pc.StateBDA);
    vec3 p=vec3(FloatArrayRO(state.PositionXBDA).Values[i],
                FloatArrayRO(state.PositionYBDA).Values[i],FloatArrayRO(state.PositionZBDA).Values[i]);
    LbvhNeighbor nearest=lbvhNearest(pc.NodesBDA,pc.ClusterCount,p);
    UIntArray(state.LabelsBDA).Values[i]=nearest.index;
    FloatArray(state.SquaredDistancesBDA).Values[i]=nearest.distance;
}
