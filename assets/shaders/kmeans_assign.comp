#version 460
#extension GL_GOOGLE_include_directive : require
#include "include/kmeans_state.glsl"
layout(local_size_x=64) in;
// Rows and centroid ranges are both paged; continuation retains the best pair.
void main(){
    uint row=pc.first+gl_GlobalInvocationID.x;
    if(gl_GlobalInvocationID.x>=pc.count)return;
    UInts labels=UInts(pc.labels);Floats distances=Floats(pc.distances);
    if(pc.innerFirst==0)UInts(pc.previous).v[row]=labels.v[row];
    uint best=pc.innerFirst==0?0:labels.v[row];
    float value=pc.innerFirst==0?distance2(load3(pc.positions,row),load3(pc.centroids,0)):distances.v[row];
    for(uint j=0;j<pc.innerCount;++j){uint c=pc.innerFirst+j;
        float d=distance2(load3(pc.positions,row),load3(pc.centroids,c));
        if(d<value){value=d;best=c;}}
    labels.v[row]=best;distances.v[row]=value;
    if(pc.innerFirst+pc.innerCount==pc.clusters){
        if(best!=UInts(pc.previous).v[row])atomicOr(Stats(pc.stats).changed,1);
        if(isnan(value)||isinf(value))atomicOr(Stats(pc.stats).invalid,1);
    }
}
