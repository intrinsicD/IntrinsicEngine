#version 460
#extension GL_GOOGLE_include_directive : require
#include "include/kmeans_state.glsl"
layout(local_size_x=64) in;
shared dvec3 partial[64];
shared uint sizes[64];
// No floating atomics or scheduler-dependent accumulation: each page's tree is fixed and the combine adds the
// pages in order.
void main(){
    uint lane=gl_LocalInvocationID.x;
    if(pc.phase==7){ // lane c: the tile's centroid c over the batch's page partials, in page order
        if(lane>=pc.count)return;
        uint c=pc.first+lane;UpdatePartials parts=UpdatePartials(pc.previous);Doubles sums=Doubles(pc.sums);
        precise dvec3 total=dvec3(0);uint count=0;
        for(uint page=0;page<pc.clusters;++page){UpdatePartial p=parts.v[page*64+lane];
            precise dvec3 next=p.sum;uint size=p.count;
            if(pc.innerFirst+page*pc.innerCount!=0){
                dvec3 stored=page==0?dvec3(sums.v[c*3],sums.v[c*3+1],sums.v[c*3+2]):total;
                next+=stored;size+=page==0?UInts(pc.counts).v[c]:count;}
            total=next;count=size;}
        sums.v[c*3]=total.x;sums.v[c*3+1]=total.y;sums.v[c*3+2]=total.z;UInts(pc.counts).v[c]=count;
        if(pc.clusters*pc.innerCount>=pc.points-pc.innerFirst){ // the batch reaches the last point (no overflow)
            precise vec3 next=count>0?vec3(total/double(count)):load3(pc.positions,Stats(pc.stats).maxDistanceIndex);
            vec3 previous=load3(pc.centroids,c);
            float shift=distance2(previous,next);
            // Exact movement remains visible even when the squared shift underflows.
            if(any(notEqual(previous,next)))atomicOr(Stats(pc.stats).changed,2u);
            if(any(isnan(next))||any(isinf(next))||isnan(shift)||isinf(shift))atomicOr(Stats(pc.stats).invalid,1);
            atomicMax(Stats(pc.stats).maxShift,floatBitsToUint(shift));store3(pc.centroids,c,next);
        }
        return;
    }
    // One fixed 64-lane tree per centroid and page (x: the tile's centroid, y: the batch's page).
    uint c=pc.first+gl_WorkGroupID.x;
    uint innerFirst=pc.innerFirst+gl_WorkGroupID.y*pc.innerCount;uint innerCount=min(pc.innerCount,pc.points-innerFirst);
    precise dvec3 sum=dvec3(0);uint count=0;
    for(uint j=lane;j<innerCount;j+=64){uint row=innerFirst+j;
        if(UInts(pc.labels).v[row]==c){sum+=dvec3(load3(pc.positions,row));++count;}}
    partial[lane]=sum;sizes[lane]=count;barrier();
    for(uint stride=32;stride>0;stride>>=1){
        if(lane<stride){partial[lane]+=partial[lane+stride];sizes[lane]+=sizes[lane+stride];}
        barrier();
    }
    if(lane==0)UpdatePartials(pc.previous).v[gl_WorkGroupID.y*64+gl_WorkGroupID.x]=UpdatePartial(partial[0],sizes[0],0u);
}
