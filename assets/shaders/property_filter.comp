#version 460
#extension GL_GOOGLE_include_directive : require
// Explicit graph property filters (averaging, Taubin, bilateral, spectral heat) in double
// precision. Row kernels visit each row's incident edges in ascending edge order, which is the
// order the CPU reference scatters them, so sums round identically.
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

layout(buffer_reference, scalar) buffer Doubles { double v[]; };
layout(buffer_reference, scalar) buffer Floats { float v[]; };
layout(buffer_reference, scalar) buffer Uints { uint v[]; };

// Load and Store move rows between a resident property (its own scalar type, tightly packed
// channels over every property row; ADR 0030) and the double working layout: working element
// (i, c) sits at i * rowStride + c * channelStride, property element (slots[i], c) at
// slots[i] * channels + c (slots 0: row i). Store also writes an optional float view and,
// for rows flagged in `fixedRows` (the restore mask), writes the input property's own value
// (`degree` aliases the typed input address, `randomWalk` its scalar type) so the stored rows
// equal what the CPU publication restores for fixed and isolated rows.
const uint ModeApply = 0, ModeBilateralWeights = 1, ModeBilateralDegree = 2,
           ModeScale = 3, ModeAxpy = 4, ModeDivide = 5, ModeCopy = 6, ModeLoad = 7, ModeStore = 8;
const uint ScalarFloat32 = 0, ScalarFloat64 = 1;

layout(push_constant, scalar) uniform Push {
    uint64_t src, dst, edges, weights, baseWeights, offsets, incidences, degree, fixedRows;
    uint64_t slots, presentation;
    uint rows, channels, edgeCount, mode;
    uint randomWalk, scalarType, rowStride, channelStride;
    double scalar;
} pc;

#include "include/exp_double.glsl"

void main()
{
    const uint id = gl_GlobalInvocationID.x;
    Doubles src = Doubles(pc.src), dst = Doubles(pc.dst);
    const uint C = pc.channels;
    if (pc.mode == ModeBilateralWeights)
    {
        if (id >= pc.edgeCount) return;
        const uint a = Uints(pc.edges).v[2 * id], b = Uints(pc.edges).v[2 * id + 1];
        precise double norm = 0.0lf;
        for (uint c = 0; c < C; ++c)
        {
            precise double d = (src.v[a * C + c] - src.v[b * C + c]) / pc.scalar;
            norm += d * d;
        }
        precise double w = Doubles(pc.baseWeights).v[id] * ExpNonPositive(-0.5lf * norm);
        Doubles(pc.weights).v[id] = w;
        return;
    }
    if (id >= pc.rows) return;
    if (pc.mode == ModeLoad || pc.mode == ModeStore)
    {
        const uint row = pc.slots != 0ul ? Uints(pc.slots).v[id] : id;
        for (uint c = 0; c < C; ++c)
        {
            const uint working = id * pc.rowStride + c * pc.channelStride, property = row * C + c;
            if (pc.mode == ModeLoad)
                dst.v[working] = pc.scalarType == ScalarFloat64 ? Doubles(pc.src).v[property]
                                                               : double(Floats(pc.src).v[property]);
            else
            {
                const bool restore = pc.degree != 0ul && Uints(pc.fixedRows).v[id] != 0;
                const double value = restore
                    ? (pc.randomWalk == ScalarFloat64 ? Doubles(pc.degree).v[property] : double(Floats(pc.degree).v[property]))
                    : src.v[working];
                if (pc.scalarType == ScalarFloat64) Doubles(pc.dst).v[property] = value;
                else Floats(pc.dst).v[property] = float(value);
                if (pc.presentation != 0ul) Floats(pc.presentation).v[property] = float(value);
            }
        }
        return;
    }
    if (pc.mode == ModeBilateralDegree)
    {
        precise double sum = 1.0lf;
        for (uint k = Uints(pc.offsets).v[id]; k < Uints(pc.offsets).v[id + 1]; ++k)
            sum += Doubles(pc.weights).v[Uints(pc.incidences).v[k]];
        Doubles(pc.degree).v[id] = sum;
        return;
    }
    if (pc.mode == ModeApply)
    {
        const bool frozen = Uints(pc.fixedRows).v[id] != 0;
        const double divisor = pc.randomWalk != 0 ? Doubles(pc.degree).v[id] : 1.0lf;
        for (uint c = 0; c < C; ++c)
        {
            precise double delta = 0.0lf;
            for (uint k = Uints(pc.offsets).v[id]; k < Uints(pc.offsets).v[id + 1]; ++k)
            {
                const uint e = Uints(pc.incidences).v[k];
                const uint a = Uints(pc.edges).v[2 * e], b = Uints(pc.edges).v[2 * e + 1];
                precise double difference = Doubles(pc.weights).v[e] * (src.v[b * C + c] - src.v[a * C + c]);
                if (a == id) delta += difference;
                else delta -= difference;
            }
            precise double update = !frozen && divisor > 0.0lf ? pc.scalar * delta / divisor : 0.0lf;
            precise double value = src.v[id * C + c] + update;
            dst.v[id * C + c] = value;
        }
        return;
    }
    for (uint c = 0; c < C; ++c)
    {
        const uint j = id * C + c;
        if (pc.mode == ModeScale) { precise double value = pc.scalar * src.v[j]; dst.v[j] = value; }
        else if (pc.mode == ModeAxpy) { precise double value = dst.v[j] + pc.scalar * src.v[j]; dst.v[j] = value; }
        else if (pc.mode == ModeDivide) { precise double value = src.v[j] / pc.scalar; dst.v[j] = value; }
        else dst.v[j] = src.v[j];
    }
}
