#version 460
// Exhaustive nearest/kNN/radius strategy under lbvh_query.comp's neighbor and header ABI.
#extension GL_GOOGLE_include_directive : require
#include "include/point_lbvh.glsl"
layout(local_size_x=256) in;
layout(push_constant,scalar) uniform BruteForcePush
{
    uint64_t targets;uint64_t targetIndices;uint64_t queries;uint64_t neighbors;uint64_t headers;
    uint targetCount;uint queryCount;uint stride;uint capacity;float radius;uint kNearestCount;uint64_t excludedIndices;
    uint targetStride;uint reserved;
}pc;
void main()
{
    uint i=gl_GlobalInvocationID.x;if(i>=pc.queryCount)return;
    LbvhNeighbors neighbors=LbvhNeighbors(pc.neighbors);LbvhHeaders headers=LbvhHeaders(pc.headers);
    uint capacity=max(pc.capacity,1u),base=i*capacity;
    for(uint j=0;j<capacity;++j)neighbors.v[base+j]=LbvhNeighbor(LBVH_INVALID,uintBitsToFloat(0x7f800000u));
    vec3 q=lbvhPoint(pc.queries,pc.stride,i);
    uint excluded=pc.excludedIndices==0?LBVH_INVALID:LbvhIndices(pc.excludedIndices).v[i];
    // Nearest (radius -1, k 0) is the single-slot kNN; a radius query with capacity 0 still counts hits.
    uint k=pc.radius<0?max(pc.kNearestCount,1u):0u,count=0;
    bool valid=lbvhValid(q) &&
        lbvhBruteQuery(pc.targets,pc.targetStride,pc.targetIndices,pc.targetCount,q,excluded,pc.radius,k,pc.capacity,neighbors,base,count);
    if(!valid)
    {
        for(uint j=0;j<capacity;++j)neighbors.v[base+j]=LbvhNeighbor(LBVH_INVALID,uintBitsToFloat(0x7f800000u));
        headers.v[i]=uvec2(0,1);return;
    }
    headers.v[i]=uvec2(count,0);
}
