#version 460

#include "lop_gpu_common.glslinc"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main()
{
    if (pc.StateBDA == uint64_t(0) || pc.TargetCount == 0u) return;
    LopGpuStateRef state = LopGpuStateRef(pc.StateBDA);
    LopGpuDiagnosticsRef diagnostics =
        LopGpuDiagnosticsRef(state.DiagnosticsBDA);
    const uint end = pc.PageCount == 0u ? pc.TargetCount : min(pc.TargetCount, pc.Reserved0 + pc.PageCount);
    float sum = pc.Reserved0 == 0u ? 0.0 : diagnostics.AverageDisplacement;
    for (uint index = pc.Reserved0; index < end; ++index)
        sum += LopFloatArrayRO(state.DisplacementsBDA).Values[index];
    diagnostics.AverageDisplacement = end == pc.TargetCount ? sum / float(pc.TargetCount) : sum;
}
