#version 460

#include "lop_gpu_common.glslinc"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main()
{
    if (pc.StateBDA == uint64_t(0)) return;
    LopGpuStateRef state = LopGpuStateRef(pc.StateBDA);
    LopGpuDiagnosticsRef diagnostics =
        LopGpuDiagnosticsRef(state.DiagnosticsBDA);
    if (diagnostics.Active != 0u)
        diagnostics.MaxDisplacementBits = 0u;
}
